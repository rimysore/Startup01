# Copy to .env.local and fill in. Everything is optional: without these the app runs in demo mode.

# Anthropic API key — switches on real AI answers (Video Doctor, Title Studio, Comments, Ask Mitra).
ANTHROPIC_API_KEY=

# Google OAuth client (type: Web application) with YouTube Data API v3 and YouTube Analytics API enabled.
# Authorised redirect URI: http://localhost:3000/api/auth/youtube/callback (and your production URL).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# At least 32 random characters; encrypts the session cookie. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Public base URL, used to build the OAuth redirect URI behind proxies. Defaults to the request origin.
# APP_URL=https://mitra.example.com
