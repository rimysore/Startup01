# Copy to .env.local and fill in. Everything is optional in local development:
# without keys the app uses an embedded database, a local test sign-in, sample AI answers and test-mode billing.

# --- Database ---------------------------------------------------------------
# Postgres connection string (Neon, Supabase, RDS, ...). Required in production.
# Locally, leave empty to use an embedded Postgres stored in .data/pglite.
DATABASE_URL=
# Optional direct (non-pooled) URL for running migrations, e.g. Neon's "unpooled" string.
# DATABASE_URL_UNPOOLED=

# --- Sessions & encryption ---------------------------------------------------
# At least 32 random characters. Encrypts stored YouTube tokens. Required in production.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Public base URL; the Google redirect URI is built from it. On Vercel you can leave it unset: the app then
# uses the address the visitor came in on (e.g. https://mitra.vercel.app). Set it once you have a domain.
# APP_URL=https://mitracreators.com

# Support, privacy, grievance and outreach inbox. Defaults to mitracontentsupport@gmail.com (src/lib/company.ts);
# set only to override.
# NEXT_PUBLIC_CONTACT_EMAIL=

# --- Google (sign-in + YouTube) ---------------------------------------------
# OAuth client of type "Web application". Enable YouTube Data API v3 and YouTube Analytics API.
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback (and your production URL).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI ------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Only if your key isn't tied to a workspace (the API then asks for anthropic-workspace-id): the workspace id, wrkspc_...
# ANTHROPIC_WORKSPACE_ID=

# --- Thumbnails --------------------------------------------------------------------
# AI-generated backgrounds with FLUX.1 [schnell] on fal.ai (~$0.003 per image, 1 credit). Key from
# https://fal.ai/dashboard/keys. Without it, thumbnails use a Pexels stock photo (below) or a drawn background.
FAL_KEY=

# Free key from https://www.pexels.com/api/ — background photos for AI-designed thumbnails. Without it,
# thumbnails use drawn gradient backgrounds.
PEXELS_API_KEY=

# --- Razorpay (subscriptions) -----------------------------------------------------
# API keys from Dashboard → Account & Settings → API Keys (use Test Mode keys first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Subscriptions → Plans: create monthly plans for ₹399 (Pro) and ₹999 (Creator+), paste their ids.
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_CREATOR=
# Dashboard → Webhooks: URL https://mitracreators.com/api/billing/webhook, events subscription.*, and this secret.
RAZORPAY_WEBHOOK_SECRET=

# --- Development switches (never set these in production) --------------------------
# ALLOW_DEV_LOGIN=1            email-only sign-in (on automatically outside production)
# ALLOW_BILLING_SIMULATION=1   "test mode" upgrades without Razorpay (on automatically outside production)
# ALLOW_EMBEDDED_DB=1          embedded database even in a production build

# --- AI cost controls -----------------------------------------------------------
# Pause all AI calls for the rest of the UTC day once estimated spend reaches this (USD). Strongly recommended.
AI_DAILY_BUDGET_USD=10
# Max real AI calls per user per minute (default 8).
# AI_RATE_PER_MINUTE=8
# Override the model or effort for one feature (doctor | titles | comments | chat), e.g.:
# AI_MODEL_DOCTOR=claude-sonnet-5-5
# AI_EFFORT_CHAT=low
# Comma-separated emails that may read /api/admin/costs.
# ADMIN_EMAILS=mitracontentsupport@gmail.com
# Admin "Find creators" tool. A YouTube Data API key (Google Cloud → Credentials → API key, restricted to
# YouTube Data API v3). Without it, searches use the admin's own connected YouTube account.
# YOUTUBE_API_KEY=
# Daily YouTube quota units the tool may spend (default 3000 of the project's 10,000).
# PROSPECT_DAILY_UNITS=3000
# Free-plan credits per month (default 10). Raise it for beta testers, e.g. 20.
# FREE_CREDITS=20
