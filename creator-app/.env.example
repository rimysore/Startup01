# Copy to .env.local and fill in. Everything is optional in local development:
# without keys the app uses an embedded database, a local test sign-in, sample AI answers and test-mode billing.

# --- Database ---------------------------------------------------------------
# Postgres connection string (Neon, Supabase, RDS, ...). Required in production.
# Locally, leave empty to use an embedded Postgres stored in .data/pglite.
DATABASE_URL=
# Optional direct (non-pooled) URL for running migrations, e.g. Neon's "unpooled" string.
# DATABASE_URL_UNPOOLED=

# --- Sessions & encryption ---------------------------------------------------
# At least 32 random characters. Encrypts stored YouTube tokens. Required in production.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Public base URL; the Google redirect URI is built from it. On Vercel you can leave it unset: the app then
# uses the address the visitor came in on (e.g. https://mitra.vercel.app). Set it once you have a domain.
# APP_URL=https://trymitraapp.com

# Support, privacy, grievance and outreach inbox. Defaults to mitracontentsupport@gmail.com (src/lib/company.ts);
# set only to override.
# NEXT_PUBLIC_CONTACT_EMAIL=

# --- Google (sign-in + YouTube) ---------------------------------------------
# OAuth client of type "Web application". Enable YouTube Data API v3 and YouTube Analytics API.
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback (and your production URL).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI ------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Only if your key isn't tied to a workspace (the API then asks for anthropic-workspace-id): the workspace id, wrkspc_...
# ANTHROPIC_WORKSPACE_ID=

# --- Thumbnails --------------------------------------------------------------------
# AI-generated backgrounds with FLUX.1 [schnell]. Recommended: Cloudflare Workers AI, FREE for ~170 images a day.
# Cloudflare dashboard → copy your Account ID (right sidebar of any page); My Profile → API Tokens → Create Token →
# "Workers AI" template → create, copy the token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Pro thumbnails ("Make my thumbnail": a new photo of the creator in the scene) with Google's Nano Banana 2.1.
# Paid only, ~$0.055 (₹4.8) per 2K image; charged 6 credits. Key: https://aistudio.google.com/apikey (needs billing).
GEMINI_API_KEY=
# Backup provider (paid, ~$0.003 per image), used only when Cloudflare isn't set: key from https://fal.ai/dashboard/keys.
# With neither, thumbnails use a Pexels stock photo (below) or a drawn background.
FAL_KEY=

# Free key from https://www.pexels.com/api/ — background photos for AI-designed thumbnails. Without it,
# thumbnails use drawn gradient backgrounds.
PEXELS_API_KEY=

# --- Razorpay (subscriptions) -----------------------------------------------------
# API keys from Dashboard → Account & Settings → API Keys (use Test Mode keys first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Subscriptions → Plans: create monthly plans for ₹99 (Pro) and ₹249 (Creator+), paste their ids.
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_CREATOR=
# Dashboard → Webhooks: URL https://trymitraapp.com/api/billing/webhook, events subscription.*, and this secret.
RAZORPAY_WEBHOOK_SECRET=

# --- Reports: WhatsApp + email (docs/WHATSAPP.md) ---------------------------------
# Vercel sends this as "Authorization: Bearer ..." to /api/cron/daily. Any long random string.
CRON_SECRET=
# WhatsApp Cloud API (Meta). From developers.facebook.com → your app → WhatsApp → API Setup.
# A permanent System User token with whatsapp_business_messaging (+ management for the template script).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Mitra's WhatsApp number with country code, digits only (for wa.me links), e.g. 919876543210
WHATSAPP_NUMBER=
# App settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
# Any string; type the same one when you add the webhook URL in Meta
WHATSAPP_VERIFY_TOKEN=
# For scripts/whatsapp-templates.mts only
# WHATSAPP_WABA_ID=
# Languages whose templates Meta approved (default "en")
# WHATSAPP_TEMPLATE_LANGS=en,hi   (all: en,hi,te,ta,mr,bn,kn,ml once Meta approves them)
# Email reports for creators without WhatsApp: Gmail SMTP with an app password (Google Account → Security →
# 2-Step Verification → App passwords) for mitracontentsupport@gmail.com. ~500 emails/day.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=Mitra <mitracontentsupport@gmail.com>

# --- Private beta --------------------------------------------------------------------------
# Invite-only (waitlist) is ON unless this is 0. Set to 0 once the Google app is published (sign-in needs no
# review; connecting YouTube shows Google's "unverified app" note until verification). See docs/GOOGLE_VERIFICATION.md.
# NEXT_PUBLIC_INVITE_ONLY=0
# After Google approves the YouTube scopes, hide the "unverified app" tip on Connections:
# NEXT_PUBLIC_GOOGLE_VERIFIED=1

# --- Development switches (never set these in production) --------------------------
# ALLOW_DEV_LOGIN=1            email-only sign-in (on automatically outside production)
# ALLOW_BILLING_SIMULATION=1   "test mode" upgrades without Razorpay (on automatically outside production)
# ALLOW_EMBEDDED_DB=1          embedded database even in a production build
# WHATSAPP_FAKE=1              WhatsApp messages are kept in memory instead of sent (tests)
# EMAIL_FAKE=1                 same for email

# --- AI cost controls -----------------------------------------------------------
# Pause all AI calls for the rest of the UTC day once estimated spend reaches this (USD). Strongly recommended.
AI_DAILY_BUDGET_USD=10
# Max real AI calls per user per minute (default 8).
# AI_RATE_PER_MINUTE=8
# Override the model or effort for one feature (doctor | titles | comments | chat), e.g.:
# AI_MODEL_DOCTOR=claude-sonnet-5-5
# AI_EFFORT_CHAT=low
# Comma-separated emails that may read /api/admin/costs.
# ADMIN_EMAILS=mitracontentsupport@gmail.com
# Admin "Find creators" tool. A YouTube Data API key (Google Cloud → Credentials → API key, restricted to
# YouTube Data API v3). Without it, searches use the admin's own connected YouTube account.
# YOUTUBE_API_KEY=
# Niche search on Breakout ideas uses ~102 YouTube quota units per new search (3 per creator per week).
# Set to 0 to switch it off without a deploy.
# YOUTUBE_SEARCH=1
# Daily YouTube quota units the tool may spend (default 3000 of the project's 10,000).
# PROSPECT_DAILY_UNITS=3000
# Free-plan credits per month (default 10). Raise it for beta testers, e.g. 20.
# FREE_CREDITS=20
